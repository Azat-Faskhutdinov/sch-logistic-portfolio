  }
}
.card-preview__desc {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
}
@media (max-width: 767px) {
  .card-preview__desc {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
  }
}
.card-preview__price {
  font-family: "Inter", sans-serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 28.6px;
}
@media (max-width: 767px) {
  .card-preview__price {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 19.5px;
  }
}
.card-preview__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}
@media (max-width: 767px) {
  .card-preview__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
}
@media (min-width: 768px) {
  .card-preview__grid > .card-preview__wrap:first-child {
    grid-column: span 2;
  }
}
.card-preview__control > .card-preview__warning {
  padding: 8px 6px 8px 16px;
  font-size: 14px;
}

.card-swiper {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 40px;
  height: 530px;
}
@media (max-width: 1880px) {
  .card-swiper {
    height: 400px;
  }
}
@media (max-width: 1279px) {
  .card-swiper {
    height: auto;
  }
}
.card-swiper__thumb {
  display: flex;
  flex-direction: column;
  gap: 16px;
  height: inherit;
  max-width: 100%;
  min-width: 0;
}
@media (max-width: 1279px) {
  .card-swiper__thumb {
    grid-column: -1/1;
    flex-direction: row;
    width: 100%;
    height: auto;
    max-height: 114px;
  }
}
@media (max-width: 767px) {
  .card-swiper__thumb {
    display: none;
  }
}
.card-swiper__wrap {
  grid-column: span 5;
  position: relative;
  height: inherit;
  max-width: 100%;
  min-width: 0;
}
@media (max-width: 1279px) {
  .card-swiper__wrap {
    grid-column: -1/1;
    order: -1;
    max-height: 932px;
  }
}
@media (max-width: 767px) {
  .card-swiper__wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
}
@media (max-width: 767px) {
  .card-swiper__navigation {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: center;
  }
}
.card-swiper__arrow {
  position: absolute;
  z-index: 5;
  top: 50%;
  transform: translateY(-50%);
}
.card-swiper__arrow--prev {
  left: 16px;
}
.card-swiper__arrow--next {
  right: 16px;
}
@media (max-width: 767px) {
  .card-swiper__arrow {
    position: static;
    transform: unset;
  }
}
.card-swiper__thumb-button {
  display: flex;
  height: 32px;
  padding: 13px 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 4px;
  background: var(--blue-back-btn, #EFECFE);
  width: 100%;
  cursor: pointer;
  transition: 200ms background-color linear;
}
@media (max-width: 1279px) {
  .card-swiper__thumb-button {
    width: 32px;
    height: 100%;
  }
}
@media (hover: hover) {
  .card-swiper__thumb-button:hover:not(.swiper-button-disabled) i {
    color: var(--blue-accent, #246BF5);
  }
}
.card-swiper__thumb-button i {
  transition: 200ms color linear;
}
@media (max-width: 1279px) {
  .card-swiper__thumb-button i {
    transform: rotate(-90deg);
  }
}
.card-swiper__thumb-button.swiper-button-disabled {
  background: var(--gray-back, #F5F5F5);
  color: var(--gray-text);
  cursor: initial;
}
.card-swiper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.card-swiper .swiper {
  max-width: 100%;
  min-width: 0;
}
.card-swiper [data-id=thumbnail] {
  height: inherit;
}
.card-swiper [data-id=thumbnail] img {
  border-radius: 4px;
}
.card-swiper [data-id=thumbnail] .swiper-slide {
  border: 2px solid transparent;
  border-radius: 6px;
  cursor: pointer;
  transition: 200ms border-color linear;
}
.card-swiper [data-id=thumbnail] .swiper-slide-thumb-active, .card-swiper [data-id=thumbnail] .swiper-slide:hover {
  border-color: var(--blue-accent, #246BF5);
}
.card-swiper [data-id=swiper] {
  height: 100%;
}
