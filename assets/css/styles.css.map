.header-submenu {
  --body-gap: 16px;
  font-family: "Inter", sans-serif;
  font-size: 14px;
  font-weight: 700;
  line-height: 18.2px;
  cursor: pointer;
}
@media (max-width: 1279px) {
  .header-submenu {
    width: 100%;
    border-bottom: 1px solid var(--blue-back-btn, #EFECFE);
    font-weight: 400;
  }
}
.header-submenu__body {
  transition: 200ms transform linear, 200ms opacity linear;
}
@media (min-width: 1280px) {
  .header-submenu__body {
    background: var(--white, #FFFFFF);
    position: absolute;
    top: 100%;
    left: var(--container-gap);
    width: 100%;
    max-width: calc(100% - var(--container-gap) * 2);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: translateY(-10px);
    opacity: 0;
    pointer-events: none;
    max-height: calc(100vh - 152px - 120px);
    overflow-y: auto;
  }
  .header-submenu__body > a {
    display: block;
    padding: 6px 12px;
  }
}
@media (min-width: 1280px) {
  .header-submenu__body--short {
    max-width: 150px;
  }
}
.header-submenu [data-id=panel] {
  display: flex;
  gap: 5px;
  align-items: center;
  justify-content: space-between;
}
@media (max-width: 1279px) {
  .header-submenu [data-id=panel] {
    padding: 12px 16px;
  }
}
.header-submenu [data-id=panel] i {
  transition: 200ms transform linear;
}
@media (width >= 1280px) {
  .header-submenu[data-id=accordion] .submenu-content {
    padding: 0 10px 0 0;
  }
}
.header-submenu[data-id=accordion] > [data-id=body] {
  padding-left: 20px;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: 200ms opacity linear, 300ms max-height linear;
}
.header-submenu[data-id=accordion] > [data-id=panel] {
  width: 100%;
}
.header-submenu[data-id=accordion] > [data-id=panel] i {
  transform: rotate(0);
}
.header-submenu[data-id=accordion].active > [data-id=panel] {
  color: var(--blue-btn);
}
@media (max-width: 1279px) {
  .header-submenu[data-id=accordion].active > [data-id=panel] {
    border-bottom: 1px solid var(--blue-back-btn, #EFECFE);
  }
}
.header-submenu[data-id=accordion].active > [data-id=body] {
  opacity: 1 !important;
  max-height: 1000px !important;
  overflow-y: auto;
  overflow-x: hidden;
}
.header-submenu--active [data-id=panel] {
  color: var(--blue-btn);
}
.header-submenu--active .header-submenu__body {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
  z-index: 501;
}
@media (max-width: 1279px) {
  .header-submenu[data-showmore] {
    display: none !important;
  }
}
.header-submenu[data-showmore] > [data-id=panel] > i {
  color: var(--blue-btn, #001A83);
  font-size: 24px;
  font-style: normal;
  font-weight: 900;
}
.header-submenu[data-showmore] .header-submenu__body {
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  max-width: 450px;
  padding: 20px;
  gap: 10px;
}
.header-submenu[data-showmore] .header-submenu__body > .header-submenu > .header-submenu__body {
  position: static;
  padding: 0;
}

