:root {
  --white: #FFFFFF;
  --blue: #003861;
  --blue-back-btn: #EFECFE;
  --black: #000000;
  --blue-btn: #001A83;
  --blue-accent: #246BF5;
  --gray-text: #5C5C5C;
  --gray-back: #F5F5F5;
  --gray-outline: #D6D6D6;
  --error: #CB0000;
}

:root {
  --grid-column: 12;
  --grid-gap: 40px;
  --grid-template: repeat(var(--grid-column), 1fr);
}
@media (width < 1280px) {
  :root {
    --grid-gap: 24px;
  }
}
@media (width < 768px) {
  :root {
    --grid-column: 6;
    --grid-gap: 16px;
  }
}

:root {
  --section-margin: 110px;
  --mm-scrollbar: 17px;
}
@media (max-width: 1880px) {
  :root {
    --section-margin: 80px;
  }
}
@media (max-width: 767px) {
  :root {
    --section-margin: 64px;
  }
}

* {
  -webkit-tap-highlight-color: transparent;
}

html:not(.transition) * {
  transition-duration: 0ms !important;
}

body {
  font-family: "Inter", sans-serif;
}

html {
  scroll-behavior: smooth;
}

[id] {
