.bread-crumbs {
  overflow-x: auto;
  margin-top: 24px;
  margin-bottom: 40px;
  font-size: 16px;
  font-style: normal;
  font-weight: 600;
  line-height: 130%; /* 20.8px */
  display: flex;
  align-items: center;
  gap: 8px;
  scrollbar-width: none;
}
@media (max-width: 767px) {
  .bread-crumbs {
    padding-left: var(--container-gap);
    padding-right: calc(var(--container-gap));
    margin-left: calc(-1 * var(--container-gap));
    width: calc(100% + var(--container-gap) + var(--container-gap)) !important;
    max-width: unset;
  }
}
@media (max-width: 767px) {
  .bread-crumbs {
    margin-block: 16px;
    font-size: 13px;
  }
}
.bread-crumbs__link {
  cursor: pointer;
  color: var(--gray-text);
  flex-shrink: 0;
  transition: 200ms color linear;
}
.bread-crumbs__link:hover {
  color: var(--blue-btn);
}
.bread-crumbs__link:last-child {
  pointer-events: none;
  color: var(--blue-btn);
}
.bread-crumbs__sep {
