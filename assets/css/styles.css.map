    cursor: pointer;
  }
  .contacts-preview__cards a.contacts-preview__link:hover p {
    color: var(--blue-accent, #246BF5);
    text-decoration-color: currentColor;
  }
}
@media (max-width: 767px) {
  .contacts-preview__link {
    display: flex;
    gap: 8px;
    align-items: center;
  }
}
.contacts-preview__link i {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 55px;
  height: 55px;
  color: var(--blue-accent, #246BF5);
  font-size: 32px;
  border-radius: 16px;
  background: var(--blue-back-btn, #EFECFE);
  margin-bottom: 24px;
}
@media (max-width: 767px) {
  .contacts-preview__link i {
    width: 40px;
    height: 40px;
    font-size: 22px;
    border-radius: 8px;
    margin-bottom: 0;
  }
}
.contacts-preview__link h4 {
  color: var(--gray-text, #5C5C5C);
  font-size: 14px;
  font-style: normal;
  font-weight: 700;
  line-height: 130%; /* 18.2px */
  letter-spacing: 0.56px;
  text-transform: uppercase;
  margin-bottom: 8px;
}
@media (max-width: 767px) {
  .contacts-preview__link h4 {
    font-size: 13px;
    margin-bottom: 4px;
  }
}
.contacts-preview__link p {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  text-decoration: underline;
  text-underline-offset: 4px;
  text-decoration-color: transparent;
  transition: 200ms text-decoration-color linear, 200ms color linear;
}
@media (max-width: 767px) {
  .contacts-preview__link p {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
  }
}
.contacts-preview__form {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}
@media (min-width: 1881px) {
  .contacts-preview__form > * {
    grid-column: span 2;
  }
  .contacts-preview__form > *:nth-child(4), .contacts-preview__form > *:nth-child(5) {
    grid-column: span 3;
  }
  .contacts-preview__form > *:last-child {
    grid-column: 4/span 3;
  }
}
@media (max-width: 1880px) and (min-width: 768px) {
  .contacts-preview__form > * {
    grid-column: span 3;
  }
  .contacts-preview__form > *:last-child, .contacts-preview__form > *:nth-last-child(2) {
    grid-column: -1/1;
    justify-self: center;
  }
}
@media (max-width: 767px) {
  .contacts-preview__form > * {
    grid-column: -1/1;
  }
