.overlay {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 500;
  background: rgba(2, 14, 60, 0.5);
  opacity: 0;
  pointer-events: none;
  transition: 200ms opacity linear;
}
.overlay--active {
  pointer-events: unset;
  opacity: 1;
}

body:has(.modal--open > .modal-center) .overlay {
  z-index: 505;
}

.pages-navigation {
  background-color: var(--gray-back);
  min-height: 100dvh;
  padding-block: 60px;
  font-family: "Inter", sans-serif;
}
@media (width < 768px) {
  .pages-navigation {
    padding-block: 40px;
  }
}
.pages-navigation__container {
  width: 100%;
  max-width: 1660px;
  padding-inline: 30px;
  margin-inline: auto;
}
.pages-navigation__body {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: var(--grid-gap);
  align-items: center;
}
@media (width < 768px) {
  .pages-navigation__body {
    row-gap: 36px;
  }
}
