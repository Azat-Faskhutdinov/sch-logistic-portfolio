  line-height: 110%;
  margin-bottom: 12px;
  color: var(--blue);
}
.pages-navigation__nav-shell {
  grid-column: span 4;
  margin-top: 120px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  order: 3;
}
@media (width < 1440px) {
