.transport-types {
  padding-block: var(--section-margin);
  background-color: var(--gray-back, #F5F5F5);
}
.transport-types__body {
  margin-top: 64px;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--grid-gap);
}
@media (max-width: 1439px) {
  .transport-types__body {
    gap: 24px;
  }
}
@media (max-width: 1279px) {
  .transport-types__body {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 1023px) {
  .transport-types__body {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
}
@media (max-width: 767px) {
  .transport-types__body {
    gap: 16px 10px;
  }
}
.transport-types__card {
  font-family: "Inter", sans-serif;
  font-size: 20px;
  font-weight: 500;
  line-height: 130%;
  width: 100%;
  aspect-ratio: 1/1;
  flex-shrink: 0;
  padding: 16px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 24px;
  text-align: center;
  background-color: var(--white);
  border-radius: 50%;
  word-break: break-word;
}
@media (min-width: 1280px) {
  .transport-types__card:nth-last-child(3) {
    grid-column-start: 2;
  }
  .transport-types__card:nth-last-child(2) {
    grid-column-start: 3;
  }
  .transport-types__card:last-child {
    grid-column-start: 4;
  }
}
@media (max-width: 1439px) {
  .transport-types__card {
    padding: 16px 24px;
  }
}
@media (max-width: 1279px) {
  .transport-types__card:last-child {
    grid-column-start: 2;
  }
}
@media (max-width: 1023px) {
  .transport-types__card:last-child {
    margin-left: -50%;
  }
}
@media (max-width: 767px) {
  .transport-types__card {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 130%;
    gap: 8px;
    padding: 15px;
  }
}
.transport-types__card i {
  color: var(--blue-accent, #246BF5);
  font-size: 32px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%; /* 44.8px */
}
@media (max-width: 767px) {
  .transport-types__card i {
    font-size: 22px;
  }
}

.transportation-stages__body {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: var(--grid-gap);
}
@media (max-width: 1023px) {
  .transportation-stages__body {
    grid-template-columns: 1fr;
  }
}
.transportation-stages__body--2cols {
  grid-template-columns: 1fr 1fr;
  margin-top: 40px;
}
@media (max-width: 1279px) {
  .transportation-stages__body--2cols {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
@media (max-width: 1023px) {
  .transportation-stages__body--2cols {
    display: flex;
    flex-direction: column-reverse;
  }
}
.transportation-stages__body--2cols .transportation-stages__card {
  height: max-content;
}
.transportation-stages__body--4cols {
  grid-template-columns: 1fr 1fr 1fr 1fr;
}
@media (max-width: 1279px) {
  .transportation-stages__body--4cols {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
@media (max-width: 1023px) {
  .transportation-stages__body--4cols {
    grid-template-columns: 1fr;
  }
}
.transportation-stages__card {
  padding: 16px;
  border-radius: 16px;
  background: var(--gray-back, #F5F5F5);
}
.transportation-stages__card p {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  max-width: 570px;
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 19.5px;
}
.transportation-stages__card-index {
  font-family: "Inter", sans-serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 28.6px;
  padding: 10px;
  display: flex;
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: var(--blue-accent, #246BF5);
  color: var(--white, #FFF);
  margin-bottom: 16px;
}
@media (max-width: 767px) {
  .transportation-stages__card-index {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 19.5px;
  }
}
.transportation-stages__card-title {
  font-family: "Inter", sans-serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 28.6px;
  margin-bottom: 24px;
}
@media (max-width: 767px) {
  .transportation-stages__card-title {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 19.5px;
    margin-bottom: 16px;
  }
}
.transportation-stages__card-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
  margin-top: 40px;
}
@media (max-width: 767px) {
  .transportation-stages__card-buttons {
    grid-template-columns: 1fr;
    margin-top: 24px;
  }
}
.transportation-stages__wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
@media (max-width: 1279px) {
  .transportation-stages__wrap {
    grid-template-columns: 1fr 1fr 1fr;
  }
}
@media (max-width: 1023px) {
  .transportation-stages__wrap {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
.transportation-stages__small-card i {
  display: flex;
  width: 55px;
  height: 55px;
  justify-content: center;
  align-items: center;
  color: var(--blue-accent, #246BF5);
  font-size: 32px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%; /* 44.8px */
  margin-bottom: 8px;
}
@media (max-width: 767px) {
  .transportation-stages__small-card i {
    width: 32px;
    height: 32px;
    font-size: 22px;
  }
}
.transportation-stages__small-card h4 {
  font-family: "Inter", sans-serif;
  font-size: 20px;
  font-weight: 500;
  line-height: 130%;
  margin-bottom: 16px;
}
@media (max-width: 767px) {
  .transportation-stages__small-card h4 {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 130%;
  }
}
.transportation-stages__small-card p {
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 19.5px;
  text-align: left;
  color: var(--gray-text);
}

.ui-dropdown {
  position: relative;
  max-height: max-content;
}
.ui-dropdown__panel {
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 19.5px;
  text-align: left;
  border-radius: 8px;
  background: var(--white, #FFF);
  padding: 12px 24px;
  border: 1px solid var(--white, #FFF);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: 200ms border-color linear;
}
@media (hover: hover) {
  .ui-dropdown__panel:hover {
    border-color: var(--blue-btn, #001A83);
  }
}
.ui-dropdown__panel:has([is-error]) {
  border-color: var(--error, #CB0000);
}
.ui-dropdown__panel:has([is-error]) .ui-dropdown__label-title {
  color: var(--error, #CB0000);
}
.ui-dropdown__panel span {
  display: block;
  width: 100%;
}
.ui-dropdown__panel input {
  cursor: initial;
  width: 100%;
}
.ui-dropdown__button {
  color: var(--blue-btn, #001A83);
  font-size: 18px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 25.2px */
  display: flex;
  width: 54px;
  height: 54px;
  padding: 13px 10px;
  justify-content: center;
  align-items: center;
  transition: 200ms transform linear;
}
.ui-dropdown__label-title {
  font-weight: 600;
  margin-bottom: 8px;
  transition: 200ms color linear;
}
.ui-dropdown__body {
  background-color: var(--white);
  box-shadow: 0px 20px 30px -10px rgba(0, 26, 131, 0.14);
  border-radius: 8px;
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  z-index: 5;
  width: 100%;
  padding: 8px;
  max-height: 300px;
  opacity: 0;
  transform: translateY(-10px);
  pointer-events: none;
  transition: 200ms opacity linear, 200ms transform linear;
}
.ui-dropdown__list {
  display: flex;
  flex-direction: column;
  padding-right: 5px;
  overflow-y: auto;
  max-height: 284px;
}
.ui-dropdown__list::-webkit-scrollbar {
  border-radius: 20px;
  width: 5px;
}
.ui-dropdown__list::-webkit-scrollbar-track {
  border-radius: 20px;
  background: var(--blue-back-btn, #EFECFE);
}
.ui-dropdown__list::-webkit-scrollbar-thumb {
  border-radius: 20px;
  background: var(--blue-accent, #246BF5);
}
.ui-dropdown__item {
  display: block;
  font-size: 14px;
  font-style: normal;
  font-weight: 500;
  line-height: 130%;
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  transition: 200ms background-color linear, 200ms color linear;
}
.ui-dropdown__item--hidden {
  display: none;
}
.ui-dropdown__item--active, .ui-dropdown__item:hover {
  color: var(--blue-btn, #001A83);
  background: var(--blue-back-btn, #EFECFE);
}
.ui-dropdown [data-id=not-found] {
  display: none;
  font-size: 14px;
  font-style: normal;
  font-weight: 500;
  line-height: 130%;
  padding: 12px 16px;
}
.ui-dropdown--open .ui-dropdown__body {
  opacity: 1;
  transform: translateY(0);
  pointer-events: unset;
}
.ui-dropdown--open .ui-dropdown__panel {
  border-color: var(--blue-btn, #001A83);
}
.ui-dropdown--open .ui-dropdown__button {
  transform: rotate(180deg);
}

.ui-form {
  position: relative;
  padding: 40px;
  border-radius: 24px;
  background: var(--blue-accent, #246BF5);
  color: var(--white);
  height: max-content;
}
@media (max-width: 1880px) {
  .ui-form {
    padding: 24px;
  }
}
@media (max-width: 767px) {
  .ui-form {
    padding: 16px;
    border-radius: 16px;
  }
}
.ui-form__desc {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  margin-top: 16px;
}
@media (max-width: 767px) {
  .ui-form__desc {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
  }
}
.ui-form__form {
  margin-top: 40px;
}
@media (max-width: 1880px) {
  .ui-form__form {
    margin-top: 24px;
  }
}
.ui-form__success {
  z-index: -1;
  position: absolute;
  width: 100%;
  height: 100%;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 24px;
  border-radius: 24px;
  background: var(--blue-accent, #246BF5);
  color: var(--white);
  padding: 40px;
  transition: 200ms opacity linear, 200ms z-index linear;
}
@media (max-width: 1880px) {
  .ui-form__success {
    padding: 24px;
  }
}
@media (max-width: 767px) {
  .ui-form__success {
    padding: 16px;
    border-radius: 16px;
    grid-template-columns: 1fr;
  }
}
.ui-form__success img {
  width: 100%;
  height: 100%;
  border-radius: 16px;
  object-fit: cover;
  aspect-ratio: 356/309;
  max-height: 309px;
}
.ui-form__success--active {
  z-index: 5;
}
.ui-form--successful .ui-form__success {
  z-index: 5;
  opacity: 1;
  pointer-events: unset;
}

.ui-swiper__container {
  display: grid;
  grid-template-columns: var(--grid-template);
  gap: 72px var(--grid-gap);
  column-gap: var(--grid-gap);
  row-gap: 72px;
}
@media (max-width: 1279px) {
  .ui-swiper__container {
    grid-column: -1/1;
    row-gap: 64px;
  }
}
@media (max-width: 767px) {
  .ui-swiper__container {
    row-gap: 40px;
  }
}
.ui-swiper__container .swiper {
  grid-column: -1/1;
  min-width: 0;
}
@media (max-width: 767px) {
  .ui-swiper__container .swiper {
    padding-left: var(--container-gap);
    padding-right: calc(var(--container-gap));
    margin-left: calc(-1 * var(--container-gap));
    width: calc(100% + var(--container-gap) + var(--container-gap)) !important;
    max-width: unset;
  }
}
@media (min-width: 768px) {
  .ui-swiper__container .swiper {
    max-width: 100%;
  }
}
.ui-swiper__title {
  grid-column: 4/span 6;
  justify-self: center;
}
@media (max-width: 1279px) {
  .ui-swiper__title {
    grid-column: -1/1;
  }
}
.ui-swiper__control {
  grid-column: 11/span 2;
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 40px;
}
@media (max-width: 1880px) {
  .ui-swiper__control {
    grid-column: 10/span 3;
  }
}
@media (max-width: 1279px) {
  .ui-swiper__control {
    grid-column: -1/1;
    justify-self: center;
    order: 3;
  }
}
@media (max-width: 767px) {
  .ui-swiper__control {
    justify-content: space-between;
    width: 100%;
  }
}
.ui-swiper__pagination {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
}
.ui-swiper__navigation {
  display: flex;
  align-items: center;
  gap: 16px;
}

.ui-tabs__tabs {
  position: relative;
}
.ui-tabs__tabs .tab-slider {
  background: var(--blue-btn, #001A83);
  position: absolute;
  left: 0;
  top: 0;
  border-radius: 8px;
  z-index: 4;
  width: 200px;
  transition: 200ms left linear, 200ms width linear;
}
.ui-tabs__tab {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  position: relative;
  z-index: 5;
  font-weight: 700;
  display: flex;
  padding: 24px 32px;
  justify-content: center;
  align-items: center;
  text-align: center;
  border-radius: 8px;
  color: var(--black, #000);
  flex-shrink: 0;
  cursor: pointer;
  transition: 200ms background-color linear, 200ms color linear;
}
@media (max-width: 767px) {
  .ui-tabs__tab {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
    font-weight: 700;
  }
}
.ui-tabs__tab[data-tab-active] {
  color: white;
}
@media (hover: hover) {
  .ui-tabs__tab:not([data-tab-active]):hover {
    color: var(--blue-accent, #246BF5);
  }
}
.ui-tabs__content {
  visibility: hidden;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: height 0.5s ease, opacity 0.5s ease;
}
.ui-tabs__content[data-tab-active] {
  visibility: visible;
  opacity: 1;
  height: auto;
  overflow: visible;
}

.ui-tabs-accordion {
  margin-bottom: var(--section-margin);
}
.ui-tabs-accordion__scroll {
  display: flex;
}
@media (min-width: 1024px) {
  .ui-tabs-accordion__scroll {
    overflow-x: auto;
    padding-bottom: 24px;
    padding-left: var(--container-gap);
    padding-right: var(--container-gap);
    margin-left: calc(-1 * var(--container-gap));
    width: calc(100% + var(--container-gap) + var(--container-gap));
  }
  .ui-tabs-accordion__scroll::-webkit-scrollbar {
    border-radius: 20px;
    height: 8px;
  }
  .ui-tabs-accordion__scroll::-webkit-scrollbar-track {
    border-radius: 20px;
    background: var(--blue-back-btn, #EFECFE);
    margin-inline: var(--container-gap);
  }
  .ui-tabs-accordion__scroll::-webkit-scrollbar-thumb {
    border-radius: 20px;
    background: var(--blue-accent, #246BF5);
  }
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__scroll {
    flex-direction: column;
  }
}
.ui-tabs-accordion__tabs {
  border-top: 1px solid var(--gray-outline, #D6D6D6);
  margin-bottom: 40px;
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__tabs {
    flex-direction: column;
    border-top: unset;
    margin-bottom: 0;
  }
}
.ui-tabs-accordion__tabs .ui-tabs__tab {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 211px;
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__tabs .ui-tabs__tab {
    margin-bottom: 24px;
    background: var(--blue-btn, #001A83);
    justify-content: space-between;
    padding: 8px 16px;
  }
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__tabs .ui-tabs__tab:not([data-tab-active]) {
    background-color: var(--gray-back, #F5F5F5);
  }
}
@media (hover: hover) {
  .ui-tabs-accordion__tabs .ui-tabs__tab:hover .detail-tabs__arrow {
    background-color: var(--blue-back-btn, #EFECFE);
  }
}
.ui-tabs-accordion__tabs .ui-tabs__tab[data-tab-active] .detail-tabs__arrow {
  transform: rotate(180deg);
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__tabs .ui-tabs__content[data-tab-active] {
    padding-bottom: 24px;
  }
}
@media (max-width: 1023px) {
  .ui-tabs-accordion__tabs .tab-slider {
    display: none;
  }
}
.ui-tabs-accordion__arrow {
  display: flex;
  width: 44px;
  height: 44px;
  padding: 13px 10px;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  border: 1px solid var(--blue-back-btn, #EFECFE);
  background-color: var(--white, #FFF);
  cursor: pointer;
  transition: 200ms background-color linear, 200ms transform linear;
}
@media (min-width: 1024px) {
  .ui-tabs-accordion__arrow {
    display: none;
  }
}
.ui-tabs-accordion__arrow i {
  color: var(--blue-btn, #001A83);
  font-size: 15px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 21px */
}

.ui-title {
  font-family: "Inter", sans-serif;
  font-size: 44px;
  font-weight: 600;
  line-height: 120%;
  text-align: center;
  margin-inline: auto;
}
@media (max-width: 767px) {
  .ui-title {
    font-family: "Inter", sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 28.8px;
  }
}
.ui-title--max-width {
  max-width: 755px;
}
.ui-title--mb {
  margin-bottom: 64px;
}
@media (max-width: 767px) {
  .ui-title--mb {
    margin-bottom: 40px;
  }
}
.ui-title--no-center {
  text-align: left;
  margin-inline: initial;
}
.ui-title--h1 {
  font-family: "Inter", sans-serif;
  font-size: 48px;
  font-weight: 700;
  line-height: 57.6px;
}
@media (max-width: 767px) {
  .ui-title--h1 {
    font-family: "Inter", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 33.6px;
  }
}

.warning {
  font-size: 17px;
  font-style: normal;
  font-weight: 500;
  line-height: 130%; /* 23.4px */
  border-radius: 8px;
  background: var(--white, #FFF);
  padding: 8px 16px;
  color: #971497;
  display: flex;
  align-items: center;
  gap: 16px;
  height: max-content;
}
@media (max-width: 767px) {
  .warning {
    font-size: 13px;
    gap: 8px;
    padding: 8px;
  }
}
.warning__shell {
  display: flex;
  width: 32px;
  height: 32px;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: #FEECFE;
  flex-shrink: 0;
}
.warning__shell i {
  color: #971497;
  font-size: 18px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 25.2px */
}
.warning a {
  color: var(--blue-btn);
  text-decoration: underline;
  text-decoration-color: currentColor;
  text-underline-offset: 4px;
  cursor: pointer;
  transition: 200ms text-decoration-color linear;
}
@media (hover: hover) {
  .warning a:hover {
    text-decoration-color: transparent;
  }
}
.warning--no-red {
  color: var(--gray-text);
}

.way-ship {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.way-ship__link {
  border-radius: 16px;
  background: var(--gray-back, #F5F5F5);
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 16px 24px;
  color: #394045;
  font-size: 22px;
  font-style: normal;
  font-weight: 600;
  line-height: 130%; /* 28.6px */
  cursor: pointer;
  transition: 200ms color linear;
}
@media (max-width: 1279px) {
  .way-ship__link {
    font-size: 19px;
    gap: 16px;
  }
}
@media (max-width: 767px) {
  .way-ship__link {
    padding: 8px 16px;
    font-size: 15px;
  }
}
@media (hover: hover) {
  .way-ship__link:hover {
    color: var(--blue-accent, #246BF5);
  }
  .way-ship__link:hover .way-ship__arrow {
    transform: translateX(5px);
  }
}
.way-ship__link p {
  flex-grow: 1;
}
.way-ship__link i {
  color: #09388A;
  font-size: 28px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 39.2px */
}
@media (max-width: 767px) {
  .way-ship__link i {
    font-size: 20px;
  }
}
.way-ship__arrow {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 40px;
  height: 40px;
  padding: 9px 16px;
  border-radius: 50%;
  background-color: var(--white);
  transition: 200ms transform linear;
}
.way-ship__arrow i {
  font-size: 18px;
}
@media (max-width: 767px) {
  .way-ship__arrow i {
    font-size: 15px;
  }
}

.y-map__wrap {
  position: relative;
  overflow: hidden;
  cursor: pointer;
  background: #ffffff url("../assets/images/map-bcg.png") no-repeat right;
  background-size: cover;
  height: 660px;
  border-radius: 24px;
  transition: 200ms background linear;
}
@media (max-width: 1880px) {
  .y-map__wrap {
    height: 502px;
  }
}
@media (max-width: 1279px) {
  .y-map__wrap {
    height: 520px;
  }
}
@media (max-width: 767px) {
  .y-map__wrap {
    height: 450px;
    border-radius: 16px;
  }
}
.y-map #map {
  position: relative;
  z-index: 5;
  width: 100%;
  height: 100%;
  cursor: pointer;
  background-color: transparent;
}
.y-map__loader {
  position: absolute;
  z-index: 4;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #000000;
  transition: opacity 0.7s ease;
  opacity: 0;
  background-color: rgba(0, 0, 0, 0.55);
}
.y-map__loader:after {
  content: "";
  position: absolute;
  top: calc(50% - 24px);
  left: calc(50% - 24px);
  width: 48px;
  height: 48px;
  border: solid 8px #ffffff;
  border-left-color: transparent;
  border-radius: 50%;
}
.y-map__loader--active {
  opacity: 1;
  z-index: 6;
}
.y-map__loader--active:after {
  animation: loader-rotation 1s linear infinite;
}

@keyframes loader-rotation {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(359deg);
  }
}
.zhd-tr-preview__container {
  display: grid;
  grid-template-columns: var(--grid-template);
  gap: 24px;
}
@media (max-width: 1439px) {
  .zhd-tr-preview__container {
    grid-template-columns: repeat(6, 1fr);
  }
}
@media (max-width: 767px) {
  .zhd-tr-preview__container {
    gap: 16px;
  }
}
.zhd-tr-preview__container h1 {
  font-family: "Inter", sans-serif;
  font-size: 48px;
  font-weight: 700;
  line-height: 57.6px;
  grid-column: span 7;
}
@media (max-width: 1880px) {
  .zhd-tr-preview__container h1 {
    grid-column: span 8;
  }
}
@media (max-width: 1439px) {
  .zhd-tr-preview__container h1 {
    grid-column: -1/1;
  }
}
@media (max-width: 767px) {
  .zhd-tr-preview__container h1 {
    font-family: "Inter", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 33.6px;
  }
}
.zhd-tr-preview__container p {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  grid-column: span 5;
}
@media (max-width: 1880px) {
  .zhd-tr-preview__container p {
    grid-column: span 6;
  }
}
@media (max-width: 1439px) {
  .zhd-tr-preview__container p {
    grid-column: span 5;
  }
}
@media (max-width: 1023px) {
  .zhd-tr-preview__container p {
    grid-column: -1/1;
  }
}
@media (max-width: 767px) {
  .zhd-tr-preview__container p {
    font-family: "Inter", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
  }
}
.zhd-tr-preview__buttons {
  grid-column: -1/1;
  margin-top: 40px;
  display: flex;
  gap: var(--grid-gap);
}
@media (max-width: 1880px) {
  .zhd-tr-preview__buttons {
    margin-top: 16px;
  }
}
@media (max-width: 1279px) {
  .zhd-tr-preview__buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .zhd-tr-preview__buttons > * {
    width: 100%;
  }
}
@media (max-width: 767px) {
  .zhd-tr-preview__buttons {
    grid-template-columns: 1fr;
    margin-top: 8px;
  }
}
