@charset "UTF-8";
*:where(:not(html, head, audio, svg, svg *, symbol, symbol *)) {
  all: unset;
  display: revert;
}
*, *::before, *::after {
  box-sizing: border-box;
}
*::before, *::after {
  display: block;
}

body {
  min-height: 100vh;
  text-rendering: optimizeSpeed;
  -webkit-font-smoothing: antialiased;
}

input,
textarea,
section,
button {
  display: block;
}

img,
svg,
picture,
video,
audio,
canvas,
iframe {
  display: block;
  overflow: hidden;
}

img,
picture,
video {
  max-width: 100%;
  height: auto;
}

