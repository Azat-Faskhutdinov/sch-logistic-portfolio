  font-size: 16px;
  line-height: 130%;
  grid-column: span 4;
  max-width: 710px;
  color: #757c86;
}
@media (width < 768px) {
  .pages-navigation__left {
    grid-column: span 8;
    order: 2;
  }
}
.pages-navigation__right {
  grid-column: span 4;
  border-radius: 20px;
  overflow: hidden;
}
@media (width < 768px) {
  .pages-navigation__right {
    grid-column: span 8;
    order: 1;
  }
}
.pages-navigation__right img {
  width: 100%;
