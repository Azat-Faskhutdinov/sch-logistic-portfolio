body:has(.modal-open) {
  -webkit-overflow-scrolling: touch;
}

.modal {
  opacity: 0;
  position: fixed;
  z-index: 505;
  top: 0;
  left: 0;
  pointer-events: none;
  display: flex;
  width: 100%;
  height: 100%;
  overflow: auto;
  transition: 200ms opacity linear;
}
.modal--open {
  opacity: 1;
  pointer-events: auto;
}
.modal--open > * {
  transform: translate(0) !important;
}

.modal-center {
  position: relative;
  margin: auto;
  width: max-content;
  padding: var(--container-gap);
}
.modal-center__close {
  position: absolute;
  top: calc(var(--container-gap) + 10px);
  right: calc(var(--container-gap) + 10px);
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--white);
  cursor: pointer;
  transition: 200ms transform linear, 200ms color linear;
}
@media (hover: hover) {
  .modal-center__close:hover {
    transform: rotate(270deg);
    color: var(--error);
  }
}
.modal-center__close i {
  color: var(--, #001A83);
  font-size: 24px;
  font-style: normal;
  font-weight: 900;
  line-height: 100%; /* 24px */
}

