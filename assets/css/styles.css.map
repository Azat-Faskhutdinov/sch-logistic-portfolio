}
.bread-crumbs::-webkit-scrollbar {
  display: none;
}

.button {
  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 0.06em;
  border-radius: 10px;
  padding: 22px 28px;
  width: max-content;
  border: 1px solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  text-transform: uppercase;
  flex-shrink: 0;
  cursor: pointer;
  transition: 200ms color linear, 200ms background-color linear, 200ms border-color linear;
}
.button--white {
  background: var(--white, #FFFFFF);
  color: var(--blue-btn);
}
@media (hover: hover) {
  .button--white:hover {
    border-color: var(--white, #FFFFFF);
    background-color: transparent;
    color: var(--white, #FFFFFF);
  }
}
.button--purple {
  background: var(--blue-back-btn);
  color: var(--blue-btn);
}
@media (hover: hover) {
  .button--purple:hover {
    color: var(--blue-accent);
    border-color: var(--blue-accent);
  }
}
.button--dark-purple {
  color: var(--blue-back-btn);
  background: var(--blue-btn);
}
@media (hover: hover) {
  .button--dark-purple:hover {
    background-color: transparent;
    color: var(--blue-btn);
    border-color: var(--blue-btn);
  }
}
.button--ghost {
  border: 1px solid var(--white, #FFF);
  color: var(--white);
}
@media (hover: hover) {
  .button--ghost:hover {
    color: var(--blue-accent, #246BF5);
    background-color: var(--white, #FFF);
  }
}
.button--blue {
  background: var(--blue-accent, #246BF5);
  color: var(--white);
}
@media (hover: hover) {
  .button--blue:hover {
    border-color: var(--blue-accent);
    color: var(--blue-accent, #246BF5);
    background-color: var(--white, #FFF);
  }
}
.button--blue-transparent {
  background: rgba(0, 0, 0, 0.1);
  color: var(--white);
}
@media (hover: hover) {
  .button--blue-transparent:hover {
    color: var(--blue-accent, #246BF5);
    background-color: var(--white, #FFF);
  }
}
.button--small-pad {
  padding: 14px 22px;
}
.button--fluid {
  width: 100%;
}
.button i {
  font-size: 25px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 35px */
}

.card-preview h1 {
