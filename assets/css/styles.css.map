  .card-swiper [data-id=swiper] {
    max-height: 920px;
  }
}
@media (max-width: 767px) {
  .card-swiper [data-id=swiper] {
    padding-left: var(--container-gap);
    padding-right: calc(var(--container-gap));
    margin-left: calc(-1 * var(--container-gap));
    width: calc(100% + var(--container-gap) + var(--container-gap)) !important;
    max-width: unset;
  }
}
.card-swiper [data-id=swiper] img {
  border-radius: 16px;
}
.card-swiper [data-id=swiper] .swiper-slide {
  opacity: 0;
  transition: 200ms opacity linear;
}
.card-swiper [data-id=swiper] .swiper-slide-active {
  opacity: 1;
}

