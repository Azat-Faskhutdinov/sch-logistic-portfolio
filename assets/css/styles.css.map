.faq-accordion__arrow {
  display: flex;
  width: 54px;
  height: 54px;
  padding: 13px 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--white, #FFF);
  transition: 200ms transform linear;
}
@media (max-width: 767px) {
  .faq-accordion__arrow {
    width: 44px;
    height: 44px;
  }
}
.faq-accordion__arrow i {
  color: var(--blue-btn, #001A83);
  font-size: 18px;
  font-style: normal;
  font-weight: 900;
  line-height: 140%; /* 25.2px */
}
@media (max-width: 767px) {
  .faq-accordion__arrow i {
    font-size: 15px;
  }
}
.faq-accordion__collapse {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
  transition: 200ms grid-template-rows linear, 200ms opacity linear, 200ms margin linear;
}
.faq-accordion__body {
  font-family: "Inter", sans-serif;
  font-size: 18px;
  font-weight: 400;
  line-height: 130%;
  color: var(--gray-text);
  min-height: 0;
  padding: 0 var(--padding);
  border-radius: 16px;
  background: var(--gray-back, #F5F5F5);
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: 200ms padding linear;
}
@media (max-width: 767px) {
