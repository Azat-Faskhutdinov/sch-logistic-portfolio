  .contacts-preview__left {
    grid-column: -1/1;
  }
}
.contacts-preview__right {
  grid-column: span calc(var(--grid-column) - 4);
}
@media (max-width: 1880px) {
  .contacts-preview__right {
    grid-column: span calc(var(--grid-column) - 5);
  }
}
@media (max-width: 1279px) {
  .contacts-preview__right {
    grid-column: -1/1;
  }
}
.contacts-preview__cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
@media (max-width: 1279px) {
  .contacts-preview__cards {
    grid-template-columns: repeat(auto-fit, minmax(294px, 1fr));
  }
}
@media (max-width: 767px) {
