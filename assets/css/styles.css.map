.submenu-content {
  background: var(--white);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
}
@media (width >= 1280px) {
  .submenu-content {
    padding: 24px;
  }
}
.submenu-content__item {
  position: relative;
  width: 100%;
}
@media (width >= 1280px) {
  .submenu-content__item {
    max-width: 350px;
    padding-block: 8px;
  }
}
@media (width >= 1280px) and (hover: hover) {
  .submenu-content__item:hover > .submenu-content__item-panel {
    color: var(--blue-accent);
  }
  .submenu-content__item:hover > .submenu-content__body {
    padding-left: 32px;
    opacity: 1;
    pointer-events: unset;
  }
}
@media (width < 1280px) {
  .submenu-content__item > a {
    display: block;
    padding: 8px 10px;
  }
  .submenu-content__item > .submenu-content__body {
    padding-left: 20px;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: 200ms opacity linear, 300ms max-height linear;
  }
  .submenu-content__item.active > [data-id=panel] {
    color: var(--blue-btn);
  }
  .submenu-content__item.active > [data-id=panel] i {
    transform: rotate(90deg);
  }
}
@media (width < 1280px) and (max-width: 1279px) {
  .submenu-content__item.active > [data-id=panel] {
    border-bottom: 1px solid var(--blue-back-btn, #EFECFE);
  }
}
@media (width < 1280px) {
  .submenu-content__item.active > [data-id=body] {
    opacity: 1 !important;
    max-height: 500px !important;
    overflow-y: auto;
    overflow-x: hidden;
  }
}
.submenu-content__item-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
}
.submenu-content__body {
  background-color: var(--white);
  border-radius: 16px;
  width: 100%;
  display: flex;
  flex-direction: column;
  transition: 200ms opacity linear, 200ms padding linear;
}
@media (width >= 1280px) {
  .submenu-content__body {
    position: absolute;
    left: 100%;
    top: var(--body-top);
    z-index: 3;
    padding-right: 32px;
    height: var(--general-height);
    opacity: 0;
    pointer-events: none;
  }
  .submenu-content__body .submenu-content__body {
    top: 0;
    height: auto;
    max-height: 400px;
    overflow-y: auto;
  }
}

