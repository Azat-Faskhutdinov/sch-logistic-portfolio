  line-height: 28.6px;
  background-color: var(--gray-back, #F5F5F5);
  border-radius: 16px;
  padding: var(--padding);
  color: var(--black);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  cursor: pointer;
  transition: 200ms background-color linear, 200ms color linear, 200ms padding linear;
}
@media (max-width: 767px) {
