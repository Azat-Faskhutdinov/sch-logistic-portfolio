    font-size: 15px;
    font-weight: 400;
    line-height: 19.5px;
  }
}
.faq-accordion--active .faq-accordion__panel {
  background-color: var(--blue-accent, #246BF5);
  color: var(--white);
  padding-bottom: 40px;
}
.faq-accordion--active .faq-accordion__arrow {
  transform: rotate(180deg);
}
